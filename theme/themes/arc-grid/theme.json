  "resources": {
    "background": "resources/background.png",
    "icon": "resources/icon.png"
  },
  "background": {
    "label": {
      "en": "Arc Grid",
      "zh": "弧光网格"
    },
    "description": {
      "en": "A dual-era energy landscape converging on a distant gate.",
