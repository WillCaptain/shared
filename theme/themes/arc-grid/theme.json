    },
    "background": {
      "kind": "preset",
      "id": "arc-grid"
    },
    "bgAnimation": "arc-grid-energy-run",
    "icon": {
      "id": "arc-grid",
      "src": "css/themes/arc-grid/resources/icon.png"
    },
    "bg": "#03070A",
    "surface": "#071119",
    "surface2": "#0B1B26",
    "surface3": "#102A36",
    "text": "#D7F7F6",
    "textDim": "#7FB9BA",
    "textMuted": "#4E7477",
    "border": "#0D5964",
    "border2": "#13889A",
    "accent": "#35F2E4",
    "accentHover": "#7CFFF4",
    "accentGlow": "rgba(53,242,228,0.26)",
    "active": "rgba(53,242,228,0.14)",
    "danger": "#FF5F55",
    "success": "#46D9A3",
    "warning": "#FFB54A",
    "info": "#46B7FF",
    "fontMono": "'JetBrains Mono', 'SFMono-Regular', Consolas, monospace",
    "radius": 4,
    "radiusSm": 2,
    "radiusLg": 7
