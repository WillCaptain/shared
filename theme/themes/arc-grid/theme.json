      "zh": "青橙电路光流汇聚于弧光门，并轻柔响应指针。"
    },
    "preview": {
      "from": "#03070A",
      "to": "#102A36",
      "left": "rgba(255,107,61,0.55)",
      "right": "rgba(53,242,228,0.60)",
      "focus_y": 0.42
    },
    "program": "animation/program.json",
    "fallback": "animation/fallback.json"
  },
  "package_shell": {
    "chrome": {
      "mode": "luminous-lines",
      "line": "#7CFFF4",
      "line_alt": "#FF9B62",
      "glow": "rgba(53,242,228,0.34)",
      "glow_alt": "rgba(255,107,61,0.24)"
    }
