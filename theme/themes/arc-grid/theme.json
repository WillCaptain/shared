{
  "schema_version": 1,
  "id": "arc-grid",
  "standard": true,
  "package_id": "ones.standard.arc-grid",
  "version": "1.0.0",
  "preserve_compiled": false,
  "preset": {
    "standard": true,
    "language": "en",
    "darkMode": true,
    "label": {
